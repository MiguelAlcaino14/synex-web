# Neon: connection string "pooled" (para runtime, usa pgbouncer)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/synex?sslmode=require
# Neon: connection string directa, sin pooler (solo para migraciones)
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/synex?sslmode=require

PORT=3000
NODE_ENV=production
ALLOWED_ORIGIN=https://synex.cl

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo@synex.cl
SMTP_PASS=app_password
CONTACT_NOTIFY_EMAIL=contacto@synex.cl
